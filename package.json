{
  "name": "slopstragram",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "npm audit --json > audit.json",
    "auth": "tsx scripts/auth.ts",
    "fetch:stories": "tsx scripts/fetch-stories.ts",
    "fetch:story": "tsx scripts/fetch-story.ts",
    "create:report": "tsx scripts/create-report.ts",
    "start": "npm exec vite",
    "lint": "oxlint",
    "check": "npm run lint && npm run typecheck && npm run test",
    "parse:stories-tray": "node --import tsx scripts/parse-stories-tray.ts",
    "parse:story": "node --import tsx scripts/parse-story.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@opentf/cli-pbar": "^0.7.2",
    "@playwright/cli": "^0.1.17",
    "consola": "^3.4.2",
    "hono": "^4.13.0",
    "ollama": "^0.6.3",
    "sharp": "^0.35.3",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^26.1.1",
    "oxlint": "^1.77.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
