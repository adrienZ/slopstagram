{
  "name": "slopstragram",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "postinstall": "bun audit --json > audit.json || true",
    "auth": "bun scripts/auth.ts",
    "fetch:stories": "bun scripts/fetch-stories.ts",
    "create:report": "bun scripts/create-report.ts",
    "start": "bun --bun vite dev --port 5173",
    "build": "bun --bun vite build",
    "lint": "bun --bun oxlint",
    "knip": "knip",
    "check": "bun run format && bun run lint && bun run knip && bun run test",
    "check:ci": "bun run format:check && bun run lint && bun run knip && bun run test:reporter",
    "format": "bun --bun oxfmt",
    "format:check": "bun --bun oxfmt --check",
    "test": "bun test --isolate --coverage ./tests",
    "test:reporter": "bun test --isolate --reporter=junit --reporter-outfile=reporter.xml ./tests || true"
  },
  "dependencies": {
    "@opentf/cli-pbar": "^0.7.2",
    "bunqueue": "^2.8.59",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "ollama": "^0.6.3",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.17",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "knip": "^6.32.1",
    "lint-staged": "^17.3.0",
    "mono-jsx": "^0.9.14",
    "nitro": "^3.0.260610-beta",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
