{
  "name": "slopstragram",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "author": "",
  "workspaces": [
    "apps/web",
    "packages/sdk"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "postinstall": "npm audit --json > audit.json || true",
    "auth": "npm run auth --workspace @slopstagram/sdk --",
    "fetch:stories": "npm run fetch:stories --workspace @slopstagram/sdk --",
    "create:report": "npm run create:report --workspace @slopstagram/sdk --",
    "bunqueue:server": "npm run bunqueue:server --workspace @slopstagram/sdk --",
    "start": "npm run start --workspace @slopstagram/web --",
    "build": "npm run build --workspace @slopstagram/web --",
    "db:generate": "npm run db:generate --workspace @slopstagram/sdk --",
    "lint": "oxlint",
    "knip": "knip",
    "check": "npm run format && npm run lint && npm run knip && npm run test",
    "check:ci": "npm run format:check && npm run lint && npm run knip && npm run test:reporter",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --import tsx --test --experimental-test-coverage tests/*.test.ts",
    "test:reporter": "mkdir -p coverage && node --import tsx --test --experimental-test-coverage --test-force-exit --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=./reporter.xml --test-reporter=lcov --test-reporter-destination=./coverage/lcov.info tests/*.test.ts",
    "db:migrate": "npm run db:migrate --workspace @slopstagram/sdk --"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.17",
    "@slopstagram/sdk": "*",
    "@tanstack/react-router": "^1.170.45",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "consola": "^3.4.2",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.3.0",
    "nitro": "^3.0.260610-beta",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "ultracite": "^7.11.0",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.17.0"
}
