{
  "name": "slopstagram",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "postinstall": "npm audit --json > audit.json || true",
    "auth": "tsx scripts/auth.ts",
    "create:report": "tsx scripts/create-report.ts",
    "fixtures:capture": "tsx scripts/fixtures-capture.ts",
    "bunqueue:server": "bunqueue start",
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "db:generate": "drizzle-kit generate",
    "lint": "oxlint",
    "knip": "knip && knip --production",
    "check": "npm run format && npm run lint && npm run knip && npm run test",
    "check:ci": "npm run format:check && npm run lint && npm run knip && npm run test:reporter && npm run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --coverage",
    "test:reporter": "vitest run --coverage --coverage.reportOnFailure --coverage.reporter=text --coverage.reporter=lcov --reporter=default --reporter=junit --outputFile.junit=./reporter.xml",
    "eval": "evalite run --outputPath=./evalite-export/last-run.json",
    "eval:export": "evalite export --output=./evalite-export"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.181",
