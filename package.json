{
  "name": "slopstragram",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "postinstall": "npm audit --json > audit.json || true",
    "auth": "tsx scripts/auth.ts",
    "fetch:stories": "tsx scripts/fetch-stories.ts",
    "create:report": "tsx scripts/create-report.ts",
    "bunqueue:server": "bunqueue start",
    "start": "vite dev --port 5173",
    "build": "vite build",
    "db:generate": "drizzle-kit generate",
    "lint": "NODE_OPTIONS='--import tsx' oxlint",
    "knip": "knip",
    "check": "npm run format && npm run lint && npm run knip && npm run test",
    "check:ci": "npm run format:check && npm run lint && npm run knip && npm run test:reporter",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --import tsx --test --experimental-test-module-mocks --experimental-test-coverage tests/*.test.ts",
    "test:reporter": "node --import tsx --test --experimental-test-module-mocks --test-force-exit --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=./reporter.xml tests/*.test.ts"
  },
  "dependencies": {
    "@opentf/cli-pbar": "^0.7.2",
    "bunqueue": "^2.8.59",
    "bunqueue-client": "^0.1.9",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "ollama": "^0.6.3",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.17",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "lint-staged": "^17.3.0",
    "mono-jsx": "^0.9.14",
    "nitro": "^3.0.260610-beta",
    "oxfmt": "^0.63.0",
    "oxlint": "1.80.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "optionalDependencies": {
    "mac-ocr": "^1.1.1"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.1"
}
