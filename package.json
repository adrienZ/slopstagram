{
  "name": "slopstragram",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "postinstall": "npm audit --json > audit.json || true",
    "auth": "tsx scripts/auth.ts",
    "fetch:stories": "tsx scripts/fetch-stories.ts",
    "create:report": "tsx scripts/create-report.ts",
    "bunqueue:server": "bunqueue start",
    "start": "vite dev --port 5173",
    "build": "vite build",
    "db:generate": "drizzle-kit generate",
    "lint": "oxlint",
    "knip": "knip",
    "check": "npm run format && npm run lint && npm run knip && npm run test",
    "check:ci": "npm run format:check && npm run lint && npm run knip && npm run test:reporter",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --import tsx --test --experimental-test-coverage tests/*.test.ts",
    "test:reporter": "mkdir -p coverage && node --import tsx --test --experimental-test-coverage --test-force-exit --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=./reporter.xml --test-reporter=lcov --test-reporter-destination=./coverage/lcov.info tests/*.test.ts"
  },
  "dependencies": {
    "@opentf/cli-pbar": "^0.7.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "bunqueue": "^2.9.17",
    "bunqueue-client": "^0.2.3",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "ollama": "^0.6.4",
    "playwright": "^1.64.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.5",
    "unstorage": "^2.0.0-beta.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "nitro": "^3.0.260903-beta",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.4",
    "vite": "^8.3.5"
  },
  "optionalDependencies": {
    "mac-ocr": "^1.2.1"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.17.0"
}
