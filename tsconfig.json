{
  "extends": ["nitro/tsconfig"],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/sdk/**/*.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "oxlint/**/*.ts",
    "tests/**/*.ts"
  ]
}
