{
  "extends": ["nitro/tsconfig"],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@/*": ["./app/*"],
      "@@/*": ["./*"]
    },
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "core/**/*.ts",
    "devtools/**/*.ts",
    "evals/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "oxlint/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "nitro/**/*.ts",
    "types/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
