{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "mono-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "sdk/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "server/**/*.ts",
    "server/**/*.tsx",
    "tests/**/*.ts"
  ]
}
