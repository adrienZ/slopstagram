{
  "extends": ["nitro/tsconfig"],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "sdk/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "oxlint/**/*.ts",
    "server/**/*.ts",
    "server/**/*.tsx",
    "types/**/*.d.ts",
    "tests/**/*.ts"
  ]
}
